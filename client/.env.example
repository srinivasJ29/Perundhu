# ==============================================================================
# PERUNDHU (பேருந்து) — Frontend Environment Configuration Template
# ==============================================================================
# NOTE: Variables prefixed with VITE_ are exposed to the client browser bundle.
# NEVER place database credentials, private API keys, or server secrets here!
# ==============================================================================

# Public API Gateway Base URL (Defaults to http://localhost:5000/api/v1 in development)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Socket.IO Real-Time Gateway URL (Defaults to http://localhost:5000 in development)
VITE_SOCKET_URL=http://localhost:5000

# Public Map Configuration (Optional, unconfirmed until Step 7/8)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Application Environment Mode (development | test | production)
VITE_APP_ENV=development
