# ==============================================================================
# TNSTC Live Tracking — Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# Never commit real credentials or .env to version control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Network Port
PORT=5000

# REST API Base Prefix
API_PREFIX=/api/v1

# Allowed Frontend Origin for CORS (e.g., http://localhost:5173 for Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection String
# Leave blank during initial foundation setup; server will boot without database.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Structured Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# JWT Configuration (Secret must be at least 32 characters in production)
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=perundhu-auth
JWT_AUDIENCE=perundhu-api

# Local Administrator Bootstrap Secret (Optional, for admin:create CLI)
ADMIN_BOOTSTRAP_SECRET=
