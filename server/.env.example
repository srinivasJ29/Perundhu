# ==============================================================================
# TNSTC Live Tracking — Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# Never commit real credentials or .env to version control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Network Port
PORT=5000

# REST API Base Prefix
API_PREFIX=/api/v1

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://perundhu.tnstc.gov.in)
CLIENT_ORIGIN=http://localhost:5173

# Reverse Proxy Trust Settings ('1', 'loopback', or comma-separated IPs; leave blank if direct)
TRUST_PROXY=

# MongoDB Connection String (Required in production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Structured Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# JWT Configuration (MUST be replaced with a secure random key >= 32 chars in production)
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=perundhu-auth
JWT_AUDIENCE=perundhu-api

# Local Administrator Bootstrap Secret (Optional, for admin:create CLI)
ADMIN_BOOTSTRAP_SECRET=

# External Hardware GPS Ingestion HMAC Secret (Minimum 32 characters; required for POST /api/v1/location/ingest)
GPS_INGESTION_HMAC_SECRET=dev-gps-ingestion-hmac-secret-min-32-chars-long

# Deterministic Route Simulator Configuration (Phase 6)
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_MS=3000
SIMULATOR_DEFAULT_SPEED_KMPH=30
SIMULATOR_SPEED_MULTIPLIER=1
SIMULATOR_WRITE_HISTORY=false
SIMULATOR_HISTORY_INTERVAL_TICKS=5
SIMULATOR_ROUTE_END_POLICY=LOOP

# Position Validation, Freshness & Route Matching Configuration (Phase 7)
LOCATION_MAX_FUTURE_SKEW_MS=5000
LOCATION_FRESHNESS_THRESHOLD_MS=30000
LOCATION_STALE_THRESHOLD_MS=120000
LOCATION_MAX_SPEED_KMPH=120
LOCATION_MAX_CROSS_TRACK_METERS=100
LOCATION_MAX_PROGRESS_JUMP_METERS=500
LOCATION_MAX_BACKWARD_METERS=30

# Next-Stop Detection, Stop Events & Dynamic ETA Configuration (Phase 8)
ETA_MAX_POSITION_AGE_MS=120000
ETA_MIN_EFFECTIVE_SPEED_KMPH=10
ETA_MAX_EFFECTIVE_SPEED_KMPH=80
ETA_DEFAULT_SPEED_KMPH=25
ETA_DEFAULT_DWELL_SECONDS=30
STOP_ARRIVAL_RADIUS_METERS=50
STOP_DEPARTURE_RADIUS_METERS=100
STOP_ARRIVAL_CONFIRMATION_COUNT=2
